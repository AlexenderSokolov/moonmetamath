///|
pub(all) struct MMExport {
  text : String
  new_label : String
  source_ids : Array[String]
}

///|
fn valid_export_label(label : String) -> Bool {
  if label.is_empty() {
    return false
  }
  for i = 0; i < label.length(); i = i + 1 {
    let ch = label.code_unit_at(i).to_int()
    if !((ch >= 65 && ch <= 90) ||
      (ch >= 97 && ch <= 122) ||
      (ch >= 48 && ch <= 57) ||
      ch == 45 ||
      ch == 46 ||
      ch == 95) {
      return false
    }
  }
  true
}

///|
pub fn export_normal_proof(
  session : MMSession,
  new_label : String,
) -> Result[MMExport, MMError] {
  let target = session.db.statements[session.target_index]
  if session.mode != "construct" {
    return Err(
      proof_error(
        target, "UnsupportedExport", "Only manually constructed ApplyLabel sessions can be exported",
      ),
    )
  }
  if session.state != "complete" {
    return Err(
      proof_error(
        target, "IncompleteSession", "Finish the proof before exporting",
      ),
    )
  }
  if !valid_export_label(new_label) {
    return Err(
      proof_error(
        target, "InvalidExportLabel", "New label must use ASCII letters, digits, period, underscore, or hyphen",
      ),
    )
  }
  if session.db.labels.contains(new_label) {
    return Err(
      proof_error(target, "DuplicateExportLabel", "New label already exists"),
    )
  }
  for decl in session.db.statements {
    if (decl.kind == "$c" || decl.kind == "$v") &&
      decl.expression.contains(new_label) {
      return Err(
        proof_error(
          target, "DuplicateExportLabel", "New label conflicts with a mathematical symbol",
        ),
      )
    }
  }
  let (lines, depth_at_target, source_ids) = match
    declaration_prefix(session.db, target) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let mut depth = depth_at_target
  lines.push(
    new_label +
    " $p " +
    target.expression.join(" ") +
    " $= " +
    session.labels.join(" ") +
    " $.",
  )
  while depth > 0 {
    lines.push("$}")
    depth = depth - 1
  }
  Ok({ text: lines.join("\n") + "\n", new_label, source_ids, })
}

///|
// Serialize declarations, never raw source text or the selected target's proof.
fn declaration_prefix(
  db : MMDatabase,
  target : MMDecl,
) -> Result[(Array[String], Int, Array[String]), MMError] {
  let lines : Array[String] = [
    "$( Generated by MoonMetamath from a verified original declaration prefix. $)",
  ]
  let source_ids : Array[String] = []
  let mut depth = 0
  for decl in db.statements {
    if decl.order >= target.order {
      break
    }
    if !source_ids.contains(decl.source) {
      source_ids.push(decl.source)
    }
    if decl.kind == "$p" && decl.status != "verified" {
      return Err(
        proof_error(
          target, "UnverifiedPrefix", "Export prefix contains an unverified theorem",
        ),
      )
    }
    if decl.kind == "${" {
      depth = depth + 1
      lines.push("${")
    } else if decl.kind == "$}" {
      depth = depth - 1
      if depth < 0 {
        return Err(
          proof_error(target, "InvalidExportContext", "Unbalanced prefix scope"),
        )
      }
      lines.push("$}")
    } else {
      let prefix = if decl.label.is_empty() { "" } else { decl.label + " " }
      let expr = decl.expression.join(" ")
      if decl.kind == "$p" {
        lines.push(
          prefix + "$p " + expr + " $= " + decl.proof.join(" ") + " $.",
        )
      } else {
        lines.push(prefix + decl.kind + " " + expr + " $.")
      }
    }
  }
  if !source_ids.contains(target.source) {
    source_ids.push(target.source)
  }
  Ok((lines, depth, source_ids))
}
